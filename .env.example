# Thesis server-side credentials. Keep real values only in private .env.
OPENAI_API_KEY=
# Company news, prices and the World tab (general market news) use this key.
FINNHUB_API_KEY=
# Financial Modeling Prep: sector, suggested peer companies, consensus and ratios.
# Which datasets work depends on your plan; missing ones show as unavailable.
FMP_API_KEY=
# Optional Premium NEWS_SENTIMENT endpoint; a free key alone does not unlock it.
# Public publisher RSS feeds need no key or Alpha Vantage subscription.
ALPHA_VANTAGE_API_KEY=
# Optional official X API. Data charges are separate from OpenAI's budget.
X_BEARER_TOKEN=
THESIS_X_ENABLED=false
# The default Reddit route uses hot-post/comment RSS with no extra key.
# Experimental own public-page Reddit reader. No API key or scraper fee.
# Defaults off; enabling does not clear a recorded Reddit access denial.
THESIS_REDDIT_HTML_ENABLED=false
# Optional future alternative; not used by the current direct OpenAI route.
OPENROUTER_API_KEY=
# AI provider: the one line to change (openai, anthropic or deepseek), then
# restart the app. Each provider picks its own quick-check and main models:
#   openai    gpt-5.4-mini-2026-03-17 / gpt-5.4-2026-03-05 (fixed)
#   anthropic claude-haiku-5-5 / claude-opus-5-5
#   deepseek  deepseek-flash / deepseek-v4-pro
THESIS_MODEL_PROVIDER=openai
# How many AI requests of one reading run at once (1–8, default 4).
# Lower it if the provider reports rate limits.
# THESIS_AI_CONCURRENCY=4
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional overrides among priced models (see thesis/providers/settings.py):
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_REASONING_MODEL=claude-sonnet-5-5
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
THESIS_MODEL_SERVING_PROVIDER=openai
# No region is pinned or independently verified.
THESIS_MODEL_PROCESSING_REGION=
# Only the approved original installation can enable paid requests, unless this
# is a separate test copy that opts in below.
THESIS_LIVE_MODELS_ENABLED=false
# Separate test copy (your own laptop or a cloud server) with your own AI key:
# its own database and cost record, and AI stops at this total cap (max 100).
# Never set these on the original installation. See docs/development/test-copy.md.
# THESIS_TEST_COPY=true
# THESIS_TEST_COPY_CAP_USD=2
THESIS_LIVE_TEST_BUDGET_USD=30
# Enable for the authorized local pitch after entering the Finnhub key.
THESIS_LIVE_DATA_ENABLED=false

# First-party SEC requests need a declared project/contact identity (not an API key).
# Filling this enables manual SEC refreshes; no automatic network polling.
SEC_USER_AGENT=
# Dedicated Telegram bot from BotFather. Connect/enable your private chat in Fledge.
TELEGRAM_BOT_TOKEN=
# Managed email login. Omit all three values for a fresh local-only demo.
# THESIS_AUTH_ENABLED=false is an operator rollback to the loopback-only owner
# session; keep this true for independent account testing.
THESIS_AUTH_ENABLED=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
THESIS_OWNER_EMAIL=
THESIS_AUTH_SITE_URL=http://127.0.0.1:8841

# Test-product sign-in with username and password (no email).
# THESIS_AUTH_MODE=password
# To sign in to the installation's existing research, create the owner login
# from this machine's shell (sign-up never grants it):
#   python -m thesis.password_auth owner <username>
#   python -m thesis.password_auth reset <username>   # forgotten password, no code

# Only when Fledge is served on the internet behind an HTTPS proxy
# (see docs/deployment/cloud-server.md). Leave empty on a laptop.
# THESIS_PUBLIC_ORIGIN=https://fledge.example.com
# Email shown in the Terms and Privacy Notice for personal-data requests (PDPA).
# THESIS_PRIVACY_CONTACT=privacy@example.com

# ---- Alerts, summaries and monitoring (all default off) ----
# Each switch below is off unless set to true. Turning one on changes what the
# running app does, so restart it only when no check or send is in progress.

# Price-move alerts: a regular-session move of at least this much, a gap against
# the QQQ index, or a larger move over two sessions. Defaults shown.
THESIS_MOVE_ALERTS=false
# THESIS_MOVE_SESSION_PERCENT=3
# THESIS_MOVE_INDEX_GAP_POINTS=2
# THESIS_MOVE_TWO_SESSION_PERCENT=5
# Model used to explain a price move (preview only). Leave empty to use the default.
# THESIS_MOVE_EXPLAINER_MODEL=

# Fast and slow watch checks, and the passive timing metrics that precede them.
THESIS_SOURCE_METRICS=false
THESIS_SENTIMENT_LANES=false
# Smaller, separate AI tasks for tone and importance instead of one large request.
THESIS_SENTIMENT_TASKS=false

# Severity routing: urgent alerts go to Telegram, others to the daily summary.
# Preview shows what would be sent without sending anything.
THESIS_ALERT_ROUTING_PREVIEW=false
THESIS_ALERT_ROUTING_LIVE=false
# Daily summary records, and whether summaries, moves and cost alerts go to Telegram.
THESIS_DAILY_REPORTS=false
THESIS_DIGEST_TELEGRAM_ENABLED=false
THESIS_MOVE_TELEGRAM_ENABLED=false
THESIS_COST_TELEGRAM_ENABLED=false
# Daily AI spend (US$) at which a cost alert is sent.
# THESIS_DAILY_COST_ALERT_USD=5

# Useful / Not useful buttons on alerts, in the app and on Telegram. Ratings are
# private, saved per account and never change the research.
THESIS_ALERT_FEEDBACK=false

# Commands from your linked Telegram chat: /today, /why SYMBOL, /world,
# /explain (one AI request through the spending ledger) and /watch SYMBOL.
# Read and explain only, never advice. Read on each poll (no restart needed).
THESIS_TELEGRAM_COMMANDS=false
